# Copy to .env (never commit). Cloud Run reads these from Secret Manager.

# Google AI Studio key (or leave empty and use Vertex AI via ADC)
GEMINI_API_KEY=

# Gemini model ID - confirm exact ID in AI Studio
GEMINI_MODEL=gemini-flash-latest

# true to route Gemini through Vertex AI instead of the API key
GOOGLE_GENAI_USE_VERTEXAI=false

# GCP project ID
GOOGLE_CLOUD_PROJECT=

# asia-south1
GOOGLE_CLOUD_LOCATION=asia-south1

# Path to service-account JSON (local dev only; Cloud Run uses its SA)
GOOGLE_APPLICATION_CREDENTIALS=

# BigQuery dataset for this project
BIGQUERY_DATASET=agri_ai_network

# Cloud Storage bucket for media/artifacts
GCS_BUCKET=

# Firebase project ID (usually = GCP project)
FIREBASE_PROJECT_ID=

# Server-side Maps key (Geocoding/Routes)
MAPS_API_KEY=

# GCP project registered for Earth Engine (enables live Sentinel-2 NDVI)
EARTH_ENGINE_PROJECT=

# API key for Cloud Translation / Speech-to-Text / Text-to-Speech (REST). Empty = demo fallbacks.
GOOGLE_CLOUD_API_KEY=

# Keyless public data (Open-Meteo weather, ISRIC SoilGrids). false = always use data/sample fixtures.
USE_PUBLIC_APIS=true


# API
PORT=8040
CORS_ORIGINS=http://localhost:3040,http://localhost:3041
